# Release builds contain no logging at all.
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
    public static int w(...);
    public static int e(...);
    public static int wtf(...);
    public static boolean isLoggable(java.lang.String, int);
}

# The viewer page is served from Java resources of the :core module (web/*).
-keepdirectories web
