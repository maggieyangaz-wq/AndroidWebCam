<?xml version="1.0" encoding="utf-8"?>
<!-- The app only listens on the LAN; it never opens outgoing connections. Cleartext is forbidden anyway. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
